{
  "eeg": {
    "sampling_rate": 250,
    "channels": 4,
    "gain": 1,
    "apply_filter": true,
    "filter_lowcut": 4,
    "filter_highcut": 30,
    "filter_order": 4
  },
  "audio": {
    "sampling_rate": 16000,
    "frame_length_ms": 30
  },
  "calibration": {
    "duration_seconds": 3,
    "impedance_good_threshold": 5000,
    "impedance_acceptable_threshold": 20000
  },
  "export": {
    "formats": ["csv", "hdf5", "wav"],
    "base_directory": "~/EEG_Recordings"
  },
  "device": {
    "type": "LEHeadphones2",
    "max_scan_time_ms": 5000
  }
}
